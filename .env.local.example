# Dify API Configuration (Required)
# Get these values from your Dify app settings
NEXT_PUBLIC_APP_ID=your-dify-app-id-here
NEXT_PUBLIC_APP_KEY=your-dify-api-key-here
NEXT_PUBLIC_API_URL=https://api.dify.ai/v1

# Optional Configuration
# Remove emojis from auto-generated conversation titles
NEXT_PUBLIC_REMOVE_EMOJIS_FROM_TITLES=true

# Note: When deploying to Vercel, add these same variables 
# in your Vercel project settings under Environment Variables